class Product:
    def __init__(self, name, price, stock):
        self.name = name
        self.price = price
        self.stock = stock

    def restock(self, qty):
            self.stock += qty

    def sell(self, qty):
                if qty <= self.stock:
                    self.stock -= qty
                    return True
                else:
                    return False

    def value(self):
                    return self.price * self.stock

pen = Product("pen", 50, 10)
print(pen.sell(4), pen.stock)
print(pen.sell(15), pen.stock)
pen.restock(4)
print(pen.value())
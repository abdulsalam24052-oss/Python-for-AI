   "source": [
    "import matplotlib.pyplot as plt\n",
    "cars = [\"Honda\", \"mazda\", \"Nissan\"]\n",
    "years = [2015, 2016, 2018]\n",
    "\n",
    "plt.plot(cars, years, marker = \"s\", label = \"market data\", color = \"gray\")\n",
    "plt.xlabel(\"cars data\")\n",
    "plt.ylabel(\"year\")\n",
    "plt.legend()\n",
    "plt.show()\n",
    "plt.savefig(\"chart.png\")\n"
   ]
  }
